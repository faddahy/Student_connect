# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only! Never prefix with NEXT_PUBLIC_. Used for admin page + account deletion.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Your live URL, no trailing slash (e.g. https://student-connect.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional. Sign-up is open to any email. Leave this empty.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=
# Email(s) that can open /admin (comma-separated). The founder account is @yagyok.
ADMIN_EMAIL=you@gmail.com
# Shown on About/Terms/Privacy pages (optional but recommended for AdSense)
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Google AdSense (leave empty until approved; ads are hidden when empty) ---
# Format: ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=
# Optional ad unit slot IDs (AdSense -> Ads -> By ad unit). Empty = AdSense picks.
NEXT_PUBLIC_ADSENSE_SLOT_FEED=
NEXT_PUBLIC_ADSENSE_SLOT_MATCHES=
# Show an ad after every N swipes (default 6, minimum 2)
NEXT_PUBLIC_AD_EVERY_N_CARDS=6
